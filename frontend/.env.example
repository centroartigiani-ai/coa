# Copia questo file in .env e compila i valori reali.
# .env NON deve mai essere committato su GitHub (è già escluso da .gitignore).

REACT_APP_BACKEND_URL=

# Chiave PUBBLICA di reCAPTCHA (site key) — può stare in chiaro nel frontend.
# La chiave segreta va SOLO in backend/.env (RECAPTCHA_SECRET_KEY), mai qui.
REACT_APP_RECAPTCHA_SITE_KEY=
