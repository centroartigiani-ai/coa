# Copia questo file in .env e compila i valori reali.
# .env NON deve mai essere committato su GitHub (è già escluso da .gitignore).

MONGO_URL=
DB_NAME=
JWT_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

RESEND_API_KEY=
SENDER_EMAIL=
NOTIFY_EMAIL=

CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=

PUBLIC_URL=

# Origini autorizzate a chiamare l'API con i cookie di sessione (separate da virgola).
# Nessun wildcard "*": elencare esplicitamente i domini reali del sito.
# Esempio: CORS_ORIGINS=https://interventi-veloci.preview.emergentagent.com,https://prontoartigiano.it
CORS_ORIGINS=

# Chiave segreta di reCAPTCHA (lato server, mai esposta nel frontend).
# Se lasciata vuota, la verifica anti-bot viene saltata con un warning nei log.
RECAPTCHA_SECRET_KEY=
